# Heurion 2.0：Caddy 反向代理 + 自动 HTTPS。HOSTNAME 来自 .env.production（heurion.org）。
{$HOSTNAME} {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# 上传（资料库 PDF 最大 50MB、docx / pptx 导入、数据集最大 100MB）；DICOM 上传单独放宽：
	# 患者页按 300MB 一批上传（apps/platform/web/src/imaging-studies.ts），加 multipart 开销
	@dicomUpload path_regexp dicomUpload ^/api/patients/[^/]+/imaging/dicom$
	@otherBody not path_regexp ^/api/patients/[^/]+/imaging/dicom$
	request_body @dicomUpload {
		max_size 320MB
	}
	request_body @otherBody {
		max_size 110MB
	}

	# MCP 与模型代理只给容器里的 dsh 用（走 127.0.0.1），不对外
	@internal path /mcp /mcp/* /llm /llm/*
	respond @internal 404

	# Aegis Cloud（aegis-os PaaS 守护进程，systemd 跑在宿主机 17080；ufw 只放行 Docker 网段）。
	# 控制台与审批静态页面由 heurion2 站点直接托管（随主站 CI 自动发布），其余 API/安装脚本去掉前缀后转发至 17080。
	@aegisCloudApi {
		path /aegis-cloud/*
		not path /aegis-cloud/dashboard /aegis-cloud/dashboard/ /aegis-cloud/approve /aegis-cloud/approve/ /aegis-cloud/install.sh
	}
	handle @aegisCloudApi {
		uri strip_prefix /aegis-cloud
		reverse_proxy host.docker.internal:17080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# 平台：页面、REST、SSE（回合事件、文档变更推送）、协同 WebSocket（/collab）、MCP
	reverse_proxy heurion2:8787 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		# SSE 与协同长连接：不缓冲、不按默认 10 分钟超时断开
		flush_interval -1
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}

	log {
		output stderr
		format json
	}
}

# 阅片器（OHIF）独立子域名：与主站不同源，读不到主站的登录令牌；平台按 Host 把这里的请求只交给阅片器入口
# （票据换 Cookie、只读 DICOMweb、OHIF 静态页面），主站的其它接口在这里都不存在。
# 平台需设置 VIEWER_HOST=viewer.<主域名>、VIEWER_URL=http://viewer:8080；DNS 要有 viewer 子域名的记录。
# 站点地址取 VIEWER_SITE（启用阅片器时在 .env.production 里设为 viewer.<主域名>）。没设置时是 viewer.localhost：
# Caddy 只给它签内部证书、不向 Let's Encrypt 申请——不放 DICOM 的托管生产机没有 viewer 子域名的 DNS，申请只会反复失败。
{$VIEWER_SITE:viewer.localhost} {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}
	request_body {
		max_size 1MB
	}
	reverse_proxy heurion2:8787 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output stderr
		format json
	}
}

# 个人技术博客（Hui Zhao · Heurion Research Blog）独立子域名：blog.heurion.org
# 平台（heurion2:8787）按 Host=blog.* 自动渲染个人博客主页（/、/en）、架构长文（/:slug、/en/:slug）与 RSS（/feed.xml）。
# 同时主站 https://heurion.org/blog 亦提供直达与跳转支持。
{$BLOG_SITE:blog.{$HOSTNAME}} {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
	request_body {
		max_size 2MB
	}
	reverse_proxy heurion2:8787 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output stderr
		format json
	}
}

# www 跳到正式域名（Cloudflare 代理回源时用 www 的 SNI，必须有自己的证书，否则 525）
www.{$HOSTNAME} {
	redir https://{$HOSTNAME}{uri} permanent
}

# 直接访问 IP 等其他主机名：跳到正式域名
:80 {
	redir https://{$HOSTNAME}{uri} permanent
}
