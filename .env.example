# DeepSeek 官方 API key（dsh 默认 provider: deepseek-official）
DEEPSEEK_API_KEY=
# 模型路由
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-flash
# 数据目录（平台数据在其下的 platform/：SQLite、dsh 工作区、dsh home）
HEURION_DATA_DIR=./data
PORT=8787
# 签发 MCP 令牌用的服务端密钥（生产必填，至少 32 字节随机串）
HEURION_SECRET=change-me-in-production-please-32b
# 开发期 API 访问令牌（多用户鉴权落地前的占位）
HEURION_DEV_TOKEN=dev
# 可选：NCBI E-utilities（提高限速）与联系邮箱（Crossref polite pool）
NCBI_API_KEY=
CONTACT_EMAIL=

# ==============================================================================
# 邮件与日程通知发信服务 (SMTP / Resend)
# 若未配置，系统在本地开发环境将使用「模拟投递」，并在系统「已发送」信箱中标记。
# 如需向外部真实邮箱（如 Gmail、QQ、163 等）真实发信，请配置以下 SMTP 参数：
# ==============================================================================
# 方式一：标准 SMTP（以 Gmail 为例，需开启两步验证并使用「应用专用密码」）：
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=Heurion 临床工作站 <your-account@gmail.com>

# 方式二：网易 163 / QQ 邮箱：
# SMTP_HOST=smtp.163.com (或 smtp.qq.com)
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@163.com
# SMTP_PASS=your-smtp-auth-code

# 方式三：Resend API
# RESEND_API_KEY=re_xxxxxxxxxxxx
# 官方工作邮箱域名（默认为 heurion.org，医生自动拥有 username@heurion.org）
MAIL_DOMAIN=heurion.org
# 外部来信 Webhook 安全通信密钥（与 Cloudflare Email Worker 保持一致）
# MAIL_INBOUND_SECRET=your-inbound-secret-key

# Aegis-OS 接入（AAP-1.0 接口、/api/mcp 网关、设置页终端授权）：尚未正式并入工作台，默认关闭；设为 1 才开放
# HEURION_AEGIS=0

# 影像存储（Orthanc）与阅片器（OHIF）：不设 ORTHANC_URL 时界面不显示影像检查（docs/design/IMAGING_STUDIES.md、docs/DEPLOY.md）
# ORTHANC_URL=http://127.0.0.1:8042
# ORTHANC_USER=heurion
# ORTHANC_PASSWORD=
# VIEWER_URL=http://127.0.0.1:8080
# VIEWER_HOST=viewer.localhost
# 影像原件保留期（天）：检查最后一次上传超过这么多天后从 Orthanc 删除原件，平台库保留索引、AI 结果与留痕；0（默认）= 不清理
# IMAGING_RETENTION_DAYS=0
