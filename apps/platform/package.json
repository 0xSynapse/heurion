{
  "name": "@heurion2/platform",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*": "./src/*",
    "./*": "./*"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "e2e": "tsx --env-file-if-exists=../../.env scripts/e2e.ts",
    "eval:fetch": "tsx scripts/eval-fetch.ts",
    "eval:build": "tsx scripts/eval-build.ts",
    "eval:claims": "tsx --env-file-if-exists=../../.env scripts/eval-claims.ts",
    "ui": "tsx scripts/ui.ts",
    "ui:accounts": "tsx scripts/ui-accounts.ts",
    "import-h1-users": "tsx --env-file-if-exists=../../.env scripts/import-h1-users.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.0-rc.2",
    "@heurion2/canvas-ui": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@niivue/niivue": "^0.69.0",
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^3.0.3",
    "dompurify": "3.4.17",
    "fflate": "^0.8.3",
    "hono": "^4.13.11",
    "lib0": "^0.2.119",
    "markdown-it": "^15.0.2",
    "nodemailer": "^10.1.4",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "tesseract.js": "^7.0.0",
    "ws": "^8.22.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.7"
  }
}
