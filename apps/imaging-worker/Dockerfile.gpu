# Heurion 2.0 医学影像微服务镜像 (NVIDIA CUDA 12.4 GPU 加速版 — T0.5)
# 职责：3D 肺结节检测 (MONAI lung_nodule_ct RetinaNet) + 点提示分割 (VISTA-3D) + 肺叶解剖定位 (TotalSegmentator)
# 实测与预期耗时：CPU 端整例 152 s / 17.3 GB 峰值 → GPU (T4 / L4 / A10G) 端整例 ~12 s / 4 GB 显存
# 构建上下文是仓库根目录：
#   docker build -f apps/imaging-worker/Dockerfile.gpu -t heurion2-imaging-worker:gpu .

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

# 复制官方 uv 二进制工具（包含 Python 3.12 自动管理与极速锁文件安装）
COPY --from=ghcr.io/astral-sh/uv:0.6.5 /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8004 \
    TORCH_DEVICE=cuda \
    LOBE_LOC_MODE=full \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=4 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# 0. 安装系统运行库与中文字体（支持中文医学 HUD 标注与标尺绘制）
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl libgomp1 fonts-dejavu-core fonts-wqy-microhei && \
    rm -rf /var/lib/apt/lists/*

# 1. 使用 uv 安装受管 Python 3.12 并按 uv.lock 锁定的精确版本安装全部依赖（保留 PyTorch CUDA 12.x 依赖轮子）
COPY apps/imaging-worker/pyproject.toml apps/imaging-worker/uv.lock ./apps/imaging-worker/
RUN cd /app/apps/imaging-worker && \
    uv python install 3.12 && \
    uv venv --python 3.12 /opt/venv && \
    uv export --frozen --no-dev --no-emit-project --no-hashes > /tmp/requirements.txt && \
    uv pip install --no-cache --python /opt/venv/bin/python -r /tmp/requirements.txt && \
    rm -f /tmp/requirements.txt

# 2. 预烘焙模型权重（GPU 镜像默认预烘焙 lung_nodule_ct + vista3d + spleen_ct 并校验 SHA-256）
ARG HEURION_BAKE_LUNG_NODULE=1
ARG HEURION_BAKE_ALL=0
ENV HEURION_MODEL_DIR=/app/models \
    HEURION_BAKE_LUNG_NODULE=${HEURION_BAKE_LUNG_NODULE} \
    HEURION_BAKE_ALL=${HEURION_BAKE_ALL}
RUN mkdir -p /app/apps/imaging-worker/src /app/apps/imaging-worker/data /app/models
# 预热脚本依赖的本地模块都要列在这里（tests/test_dockerfile_bake_deps.py 会检查）
COPY apps/imaging-worker/src/model_registry.py apps/imaging-worker/src/bake_models.py apps/imaging-worker/src/errors.py /app/apps/imaging-worker/src/
RUN /opt/venv/bin/python /app/apps/imaging-worker/src/bake_models.py

# 3. 复制其余业务源码
COPY apps/imaging-worker/src /app/apps/imaging-worker/src

WORKDIR /app/apps/imaging-worker

# 4. 创建非 root 用户运行，确保隔离安全性并赋予模型目录与数据目录写权限
RUN useradd -m -u 1000 imaginguser && \
    chown -R imaginguser:imaginguser /app /opt/venv

USER imaginguser
EXPOSE 8004

# 5. 健康检查
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8004/health')"

# 6. 启动推理服务
CMD ["uvicorn", "src.server:app", "--host", "0.0.0.0", "--port", "8004", "--workers", "1"]
