          "owner": "dev:exp3-utility-u1",
          "trigger_pattern": "user_reverted_turn",
          "rule": "用户曾撤销过超出范围的 AI 回合（user_reverted_turn）：针对润色、改写或段间过渡/衔接任务，严格遵守最小修改范围，只允许对用户点名的第一个目标段落（单个块 id）调用 replace_text 或 replace_block，严禁同时改动后续相邻段落或调用 merge 合并段落。",
          "evidence_count": 2,
          "created_at": "2026-10-22T16:43:41.527Z"
        },
        {
